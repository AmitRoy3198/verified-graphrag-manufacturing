    mfg:actionType "Preventive" ;
    mfg:addresses ex:failure_FAILURE1107 ;
    mfg:date "2026-03-21"^^xsd:date ;
    mfg:durationH 2.0 ;
    mfg:onMachine ex:machine_I1 .

ex:action_WO1108 a mfg:MaintenanceAction ;
    mfg:actionType "Corrective" ;
    mfg:addresses ex:failure_INC208 ;
    mfg:date "2026-03-26"^^xsd:date ;
    mfg:durationH 2.5 ;
