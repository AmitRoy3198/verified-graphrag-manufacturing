ex:buffer_B1 a mfg:Buffer ;
    rdfs:label "Buffer B1" ;
    mfg:capacity 40 ;
    mfg:feeds ex:machine_P2 .

ex:buffer_B5 a mfg:Buffer ;
    rdfs:label "Buffer B5" ;
    mfg:capacity "value:15" ;
    mfg:feeds ex:machine_K1 .

ex:buffer_B6 a mfg:Buffer .

ex:buffer_REDBOX a mfg:Buffer ;
    rdfs:label "REDBOX" ;
    mfg:capacity 0 ;
    mfg:feeds ex:machine_I2 .

ex:failure_INSPECTIONSTATIONREJECTEDPARTS a mfg:Failure ;
    mfg:date "2023-04-01"^^xsd:date ;
    mfg:downtimeH 0.75 ;
    mfg:failureMode "Rejected parts" ;
    mfg:onMachine ex:machine_I1 .

ex:line_LINE1 a mfg:ProductionLine ;
    rdfs:label "Line 1" ;
    mfg:finalMachine ex:machine_K1 .

ex:buffer_B2 a mfg:Buffer ;
    rdfs:label "Buffer B2" ;
    mfg:capacity 30 ;
    mfg:feeds ex:machine_W1 .

ex:buffer_B3 a mfg:Buffer ;
    rdfs:label "Buffer B3" ;
    mfg:capacity 25 ;
    mfg:feeds ex:machine_A1 .

ex:buffer_B4 a mfg:Buffer ;
    rdfs:label "Buffer B4" ;
    mfg:capacity 20 ;
    mfg:feeds ex:machine_A1 .

ex:failure_FAILURE1107 a mfg:Failure ;
    mfg:date "2026-03-21"^^xsd:date ;
    mfg:downtimeH 2.0 ;
    mfg:failureMode "camera calibration and lens cleaning" ;
    mfg:onMachine ex:machine_I1 .

ex:failure_INC201 a mfg:Failure ;
    mfg:date "2026-03-03"^^xsd:date ;
    mfg:downtimeH 4.5 ;
    mfg:duringShift ex:shift_NIGHT ;
    mfg:failureMode "Hydraulic leak at the main cylinder seal" ;
    mfg:onMachine ex:machine_P2 .

ex:failure_INC202 a mfg:Failure ;
    mfg:date "2026-03-05"^^xsd:date ;
    mfg:downtimeH 2.0 ;
    mfg:duringShift ex:shift_EARLY ;
    mfg:failureMode "Screwdriver torque fault" ;
    mfg:onMachine ex:machine_A1 .

ex:failure_INC203 a mfg:Failure ;
    mfg:date "2026-03-09"^^xsd:date ;
    mfg:downtimeH 3.0 ;
    mfg:duringShift ex:shift_LATE ;
    mfg:failureMode "Die misalignment" ;
    mfg:onMachine ex:machine_P1 .

ex:failure_INC204 a mfg:Failure ;
    mfg:date "2026-03-12"^^xsd:date ;
    mfg:downtimeH 1.5 ;
    mfg:duringShift ex:shift_NIGHT ;
    mfg:failureMode "Pump failure in the spray circuit" ;
    mfg:onMachine ex:machine_W1 .

ex:failure_INC205 a mfg:Failure ;
    mfg:date "2026-03-17"^^xsd:date ;
    mfg:downtimeH 1.0 ;
    mfg:duringShift ex:shift_LATE ;
    mfg:failureMode "sensor fault" ;
    mfg:onMachine ex:machine_A1 .

ex:failure_INC206 a mfg:Failure ;
    mfg:date "2026-03-01"^^xsd:date ;
    mfg:downtimeH 5.0 ;
    mfg:duringShift ex:shift_NIGHT ;
    mfg:failureMode "Hydraulic leak" ;
