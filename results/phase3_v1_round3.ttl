@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:action_B3 a mfg:MaintenanceAction ;
    mfg:actionType "Corrective" ;
    mfg:date "2026-03-10"^^xsd:date ;
    mfg:durationH 0.5 ;
    mfg:onMachine ex:machine_B3 .

