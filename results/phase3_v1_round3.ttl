ex:failure_INC207 a mfg:Failure ;
    mfg:date "2026-03-24"^^xsd:date ;
    mfg:downtimeH 0.5 ;
    mfg:duringShift ex:shift_EARLY ;
    mfg:failureMode "Film jam" ;
    mfg:onMachine ex:machine_K1 .

ex:failure_INC208 a mfg:Failure ;
    mfg:date "2026-03-26"^^xsd:date ;
    mfg:downtimeH 2.5 ;
    mfg:duringShift ex:shift_NIGHT ;
    mfg:failureMode "Screwdriver torque fault on screwdriver 1" ;
    mfg:onMachine ex:machine_A1 .

ex:line_LINEA a mfg:ProductionLine ;
    rdfs:label "Line A" ;
    mfg:finalMachine ex:machine_P1 .

ex:machine_B3 mfg:feeds ex:buffer_B4 .

ex:shift_EARLY a mfg:Shift ;
    rdfs:label "Early" ;
    mfg:startHour 6 .

ex:shift_LATE a mfg:Shift ;
    rdfs:label "Late" ;
    mfg:startHour 14 .

ex:line_A a mfg:ProductionLine ;
    rdfs:label "Line A" ;
    mfg:finalMachine ex:machine_A1 .

ex:machine_K1 a mfg:Machine ;
    rdfs:label "Packer K1" ;
    mfg:cycleTimeS "/25 s" ;
    mfg:machineType "Packing" ;
    mfg:mtbfH "/350 h" ;
    mfg:mttrH "/72 min" ;
    mfg:partOfLine ex:line_LINEA ;
    mfg:powerKW "/12 kW" .

ex:machine_P1 a mfg:Machine ;
    rdfs:label "Press P1" ;
    mfg:cycleTimeS "" ;
    mfg:machineType "Press" ;
    mfg:mtbfH "" ;
    mfg:mttrH "" ;
    mfg:powerKW "" .

ex:machine_I1 a mfg:Machine ;
    rdfs:label "Inspection station I1" ;
    mfg:cycleTimeS "]0.3" ;
    mfg:feeds ex:buffer_B3 ;
    mfg:machineType "Inspection" ;
    mfg:mtbfH "]600.0" ;
    mfg:mttrH "]1.0" ;
    mfg:partOfLine ex:line_A ;
    mfg:powerKW "]6.0" .

ex:machine_W1 a mfg:Machine ;
    rdfs:label "Washer W1" ;
    mfg:cycleTimeS "defaulted" ;
    mfg:feeds ex:buffer_B2 ;
    mfg:machineType "Washer" ;
    mfg:mtbfH "defaulted" ;
    mfg:mttrH "defaulted" ;
    mfg:partOfLine ex:line_A ;
    mfg:powerKW "defaulted" .

ex:shift_NIGHT a mfg:Shift ;
    rdfs:label "Night" ;
    mfg:startHour 22 .

ex:machine_P2 a mfg:Machine ;
    rdfs:label "Press P2" ;
    mfg:cycleTimeS "time_unit(48)" ;
    mfg:feeds ex:buffer_P2 ;
    mfg:machineType "Press" ;
    mfg:mtbfH "time_unit(140)" ;
    mfg:mttrH "time_unit(4)" ;
    mfg:partOfLine ex:line_HTTPEXAMPLEORGLINELINEHTTPEXAMPLEORGLINELINEA ;
    mfg:powerKW "time_unit(90)" .

ex:machine_A1 a mfg:Machine ;
    rdfs:label "Assembly cell A1" ;
    mfg:cycleTimeS "defaulted" ;
    mfg:machineType "Assembly" ;
    mfg:mtbfH "defaulted" ;
    mfg:mttrH "defaulted" ;
    mfg:partOfLine ex:line_A ;
    mfg:powerKW "defaulted" .

